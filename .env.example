# SPDX-License-Identifier: Apache-2.0
#
# OIDC credentials for `make helm-dev-auth`.
# Any OpenID Connect-compliant issuer works (Google, Dex, Keycloak, etc.).
#
# Copy to .env (gitignored) and fill in values.
# The Makefile includes `.env`; run `make helm-dev-auth` without passing OIDC_* on the
# `make ...` CLI (avoids shell history). Alternatively: `source .env && make helm-dev-auth`

OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
