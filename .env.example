# SPDX-License-Identifier: Apache-2.0
#
# OIDC credentials for `make helm-dev-auth`.
# Any OpenID Connect-compliant issuer works (Google, Dex, Keycloak, etc.).
#
# Copy to .env and fill in values, then:
#   source .env && make helm-dev-auth

OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
